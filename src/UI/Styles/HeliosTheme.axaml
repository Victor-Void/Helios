<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Helios Material You theme.
        Default dark palette below acts as fallback.
        HeliosThemeLoader overrides these with live colours from
        ~/.local/state/quickshell/user/generated/colors.json
        when the Quickshell dotfiles wallpaper generator is active.
    -->

    <Styles.Resources>
        <SolidColorBrush x:Key="background"             Color="#121316" />
        <SolidColorBrush x:Key="surface_container"      Color="#1e2024" />
        <SolidColorBrush x:Key="surface_container_high" Color="#2a2c30" />
        <SolidColorBrush x:Key="on_surface"             Color="#e4e2e5" />
        <SolidColorBrush x:Key="on_surface_variant"     Color="#c5c6cf" />
        <SolidColorBrush x:Key="primary"                Color="#b4c7f0" />
        <SolidColorBrush x:Key="outline_variant"        Color="#44474e" />
        <SolidColorBrush x:Key="error"                  Color="#ffb4ab" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource background}" />
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
        <Setter Property="FontFamily" Value="Google Sans Flex, Ubuntu, DejaVu Sans, Liberation Sans, sans-serif" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Panel backgrounds -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource surface_container}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.helios">
        <Setter Property="Background" Value="{DynamicResource surface_container_high}" />
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.helios:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource surface_container}" />
    </Style>

    <!-- Active state (red-orange border, used by XG Mobile enable) -->
    <Style Selector="Button.helios.helios-active">
        <Setter Property="BorderBrush" Value="{DynamicResource error}" />
        <Setter Property="Background" Value="#3A2A24" />
    </Style>

    <Style Selector="Button.helios.helios-active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4A3530" />
    </Style>

    <!-- Tall mode-selector buttons (perf/GPU) -->
    <Style Selector="Button.helios-tall">
        <Setter Property="Background" Value="{DynamicResource surface_container_high}" />
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.helios-tall:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource surface_container}" />
    </Style>

    <Style Selector="Button.helios-tall TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ComboBox -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource surface_container_high}" />
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Slider (accent colour) -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource primary}" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
    </Style>

    <!-- TextBlock -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
    </Style>

    <Style Selector="TextBlock.label-dim">
        <Setter Property="Foreground" Value="{DynamicResource on_surface_variant}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{DynamicResource primary}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Separator -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource outline_variant}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <!-- TabControl -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource background}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource on_surface_variant}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource on_surface}" />
    </Style>

</Styles>
